# ---- required in production ----
# Sign the auth cookie. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ---- set by the host, override only if you need to ----
# PORT=4000

# Where the SQLite database and uploaded media live. MUST point at a mounted volume in production.
# DATA_DIR=/data

# Only needed when the client is hosted on a DIFFERENT origin than this server.
# Leave unset for the single-container deploy, which is same-origin.
# CLIENT_ORIGIN=https://bento.premiummarkup.com
